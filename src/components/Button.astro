---
// Every button on the site is this. With href it is a link styled as a
// button (most actions go somewhere); without one it is a real <button>
// (type "button" unless told "submit") for a form. Page calls to action are
// pills; the header's are small rounded buttons. primary is ink, outline a
// surface with a hairline, ghost text that fills on hover.
//
// Sign-up awareness: a button marked `signup` ("primary" for the main call
// to action, "free" for the Free plan's card, "plan:<id>" for a paid plan's)
// follows the app's answer to "is sign-up open?" — GET <app>/api/signup →
// { free, paid, plans }, two switches the operator controls, asked once per
// page by src/lib/signup-client.ts (the layout names the endpoint):
//   free open                → as rendered ("Get started" → /signup)
//   free closed, paid open   → "Choose a plan" → /pricing/ (paid plan cards
//                              keep /signup?plan=<id>; the Free card asks
//                              for access)
//   both closed              → "Request access" → /signup (the app's page
//                              shows the request form)
//   no answer                → as rendered: the app's page tells the truth.
// The server renders the open state, so nothing moves unless it must.
interface Props {
  /** Omit for a <button>. */
  href?: string;
  /** A <button>'s type. */
  type?: "button" | "submit";
  variant?: "primary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  shape?: "pill" | "rounded";
  block?: boolean;
  /** Follow the app's sign-up switches: "primary", "free" or "plan:<id>". */
  signup?: string;
  class?: string;
  [key: string]: unknown;
}
import { buttonVariants } from "../recipes/button.ts";
import { cn } from "../react/cn.ts";
const { href, type = "button", variant = "primary", size = "lg", shape = size === "sm" ? "rounded" : "pill", block = false, signup, class: cls = "", ...rest } = Astro.props;
// The same Button as the dashboard's (recipes/button.ts): a page's call to
// action takes the site-* sizes and, mostly, the pill shape. "outline" is the
// kit's secondary.
const VARIANT = { primary: "primary", outline: "secondary", ghost: "ghost" } as const;
const SIZE = { lg: "site-lg", md: "site-md", sm: "site-sm" } as const;
const classes = cn(buttonVariants({ variant: VARIANT[variant], size: SIZE[size], shape, block }), cls);
---
{href !== undefined ? <a href={href} class={classes} data-signup={signup} {...rest}><slot /></a> : <button type={type} class={cn(classes, "cursor-pointer")} {...rest}><slot /></button>}

<script>
  // One question to the app per page (src/lib/signup-client.ts); the
  // buttons marked data-signup follow its answer.
  import { startSignup } from "../lib/signup-client.ts";
  if (document.querySelector("a[data-signup]")) startSignup();
</script>
