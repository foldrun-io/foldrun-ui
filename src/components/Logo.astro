---
// The foldrun mark (recipes/mark.ts — the dashboard's FoldrunMark draws the
// same geometry): a folder with the run light at its corner, and the name
// beside it. The light is the outline's own colour (currentColor: black in
// light, white in dark; owner, 7 Nov 2026); its ring is the page colour so
// it reads as cut out and never touches the outline.
interface Props { class?: string; mark?: boolean; suffix?: string }
import { MARK } from "../recipes/mark.ts";
const { class: cls = "", mark = false, suffix } = Astro.props;
---
<span class:list={["inline-flex items-center gap-2 font-semibold tracking-[-0.02em] text-fg", cls]}>
  <svg width="22" height="22" viewBox={MARK.viewBox} fill="none" stroke="currentColor" stroke-width={MARK.strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
    <path d={MARK.folder} />
    <path d={MARK.line} />
    <circle {...MARK.ring} fill="var(--paper)" stroke="none" />
    <circle {...MARK.light} fill="currentColor" stroke="none" />
  </svg>
  {!mark && <span class="text-[1.0625rem] leading-none">foldrun{suffix && <span class="ms-1.5 font-normal text-fg-muted">{suffix}</span>}</span>}
</span>
