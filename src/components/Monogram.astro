---
/** @deprecated since 0.2.1: initials read as placeholders (owner, 7 Nov 2026).
 * Use BrandMark (the vendor's own mark, or nothing) or LogoWall. Kept so a
 * site on an older call still builds; nothing in the kit uses it. */
// A vendor's tile: a letter or two of its name.
interface Props { name: string; size?: "sm" | "md" }
const { name, size = "md" } = Astro.props;
const words = name.replace(/\(.*?\)/g, "").replace(/[^A-Za-z0-9 ]/g, "").split(/\s+/).filter(Boolean);
const mark = (words.length > 1 ? words[0][0] + words[1][0] : (words[0] ?? "?").slice(0, 2)).toUpperCase();
---
<span aria-hidden="true" class:list={["grid shrink-0 place-items-center rounded-lg border bg-surface font-semibold shadow-raised", size === "sm" ? "size-8 text-[11px]" : "size-10 text-xs"]}>{mark}</span>
