{
  "name": "@foldrun/ui",
  "version": "0.1.0",
  "description": "foldrun's web components and design tokens: the one look shared by foldrun.io and docs.foldrun.io. Astro components and CSS as source.",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldrun-io/foldrun-ui.git"
  },
  "files": [
    "src",
    "fonts",
    "scripts/check-native.mjs",
    "LICENSE",
    "LICENSING.md",
    "README.md"
  ],
  "exports": {
    "./styles.css": "./src/styles/global.css",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./lib/*": "./src/lib/*",
    "./fonts/*": "./fonts/*"
  },
  "bin": {
    "foldrun-ui-check-native": "scripts/check-native.mjs"
  },
  "scripts": {
    "check": "node scripts/check-native.mjs src demo && astro check",
    "build": "astro build",
    "dev": "astro dev --port 4350"
  },
  "peerDependencies": {
    "astro": ">=7.2.9",
    "tailwindcss": ">=4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
