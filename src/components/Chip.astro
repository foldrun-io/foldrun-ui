---
// A rounded chip: a short label with something in front of it (a badge, a
// monogram). With href it is a link (the hero's announcement pill).
interface Props { href?: string; class?: string }
const { href, class: cls = "" } = Astro.props;
const Tag = href ? "a" : "span";
---
<Tag href={href} class:list={["inline-flex items-center gap-2 rounded-full border bg-surface py-1 pr-3 pl-1 text-sm text-fg-muted", href && "transition-colors hover:text-fg", cls]}><slot /></Tag>
