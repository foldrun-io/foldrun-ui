---
// A small pill: a status beside a name ("Waits for you"), a label in the
// hero's pill. tone picks the colour from the status tokens.
import Icon from "./Icon.astro";
interface Props { tone?: "neutral" | "outline" | "warning" | "success"; icon?: string; class?: string }
const { tone = "neutral", icon, class: cls = "" } = Astro.props;
---
<span class:list={[
  "inline-flex h-5 shrink-0 items-center gap-1 rounded-full px-2 font-sans text-xs font-medium whitespace-nowrap",
  tone === "neutral" && "bg-muted text-fg",
  tone === "outline" && "border text-fg-muted",
  tone === "warning" && "border border-warning-line bg-warning-soft text-warning",
  tone === "success" && "border border-success-line bg-success-soft text-success",
  cls,
]}>{icon && <Icon name={icon} class="size-3" />}<slot /></span>
