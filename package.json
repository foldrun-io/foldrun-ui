{
  "name": "@foldrun/ui",
  "version": "0.3.2",
  "description": "foldrun's one component set and design tokens: the React kit the dashboard and the operator console are drawn with, and the Astro components foldrun.io, foldrun.ir and docs.foldrun.io are built from. Source, not a build.",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldrun-io/foldrun-ui.git"
  },
  "files": [
    "src",
    "fonts",
    "scripts/check-native.mjs",
    "LICENSE",
    "LICENSING.md",
    "README.md",
    "scripts/check-security.mjs"
  ],
  "exports": {
    "./styles.css": "./src/styles/global.css",
    "./kit.css": "./src/styles/kit.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./lib/*": "./src/lib/*",
    "./fonts/*": "./fonts/*",
    "./react/button": "./src/react/button.tsx",
    "./react/chart": "./src/react/chart.tsx",
    "./react/checklist": "./src/react/checklist.tsx",
    "./react/choice-cards": "./src/react/choice-cards.tsx",
    "./react/choice": "./src/react/choice.tsx",
    "./react/cn": "./src/react/cn.ts",
    "./react/combobox": "./src/react/combobox.tsx",
    "./react/confirm": "./src/react/confirm.tsx",
    "./react/copy-block": "./src/react/copy-block.tsx",
    "./react/date-time-field": "./src/react/date-time-field.tsx",
    "./react/dialog": "./src/react/dialog.tsx",
    "./react/disclosure": "./src/react/disclosure.tsx",
    "./react/file-button": "./src/react/file-button.tsx",
    "./react/input": "./src/react/input.tsx",
    "./react/link": "./src/react/link.tsx",
    "./react/list-search-model": "./src/react/list-search-model.ts",
    "./react/list": "./src/react/list.tsx",
    "./react/mark": "./src/react/mark.tsx",
    "./react/menu": "./src/react/menu.tsx",
    "./react/overview": "./src/react/overview.tsx",
    "./react/page-tabs": "./src/react/page-tabs.tsx",
    "./react/page": "./src/react/page.tsx",
    "./react/pager": "./src/react/pager.tsx",
    "./react/paging": "./src/react/paging.ts",
    "./react/popover": "./src/react/popover.tsx",
    "./react/prompt": "./src/react/prompt.tsx",
    "./react/return-focus": "./src/react/return-focus.ts",
    "./react/segmented": "./src/react/segmented.tsx",
    "./react/select": "./src/react/select.tsx",
    "./react/skeleton": "./src/react/skeleton.tsx",
    "./react/slider": "./src/react/slider.tsx",
    "./react/steps": "./src/react/steps.tsx",
    "./react/table": "./src/react/table.tsx",
    "./react/time-field": "./src/react/time-field.tsx",
    "./react/toast": "./src/react/toast.tsx",
    "./react/tooltip": "./src/react/tooltip.tsx",
    "./recipes/button": "./src/recipes/button.ts",
    "./recipes/input": "./src/recipes/input.ts",
    "./recipes/mark": "./src/recipes/mark.ts"
  },
  "bin": {
    "foldrun-ui-check-native": "scripts/check-native.mjs",
    "foldrun-ui-check-security": "scripts/check-security.mjs"
  },
  "scripts": {
    "check": "node scripts/check-native.mjs src demo && node scripts/check-security.mjs src demo && astro check && npm run -s typecheck && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.react.json",
    "test": "node --test tests/*.test.ts",
    "demo:build": "astro build",
    "demo:dev": "astro dev --port 4350"
  },
  "peerDependencies": {
    "astro": ">=7.2.9",
    "next": ">=16.4.3",
    "react": ">=19.3.1",
    "react-dom": ">=19.3.1",
    "tailwindcss": ">=4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.2.9",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
