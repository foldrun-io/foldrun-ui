---
// The shell every page of every foldrun web property shares: the head
// (title, description, canonical, Open Graph, schema.org), the theme before
// first paint, the font, then a header slot, the page, a footer slot.
//
// The theme: a tiny inline script sets <html data-theme> from the theme
// switch's saved choice before the first paint, so a dark-mode reader never
// sees a white flash; it also marks html.js so disclosures and menus hide
// only when there is script to open them. Without a choice the page follows
// the system.
//
// Sign-up: when signupApi and signupUrl are given, buttons marked `signup`
// follow the app's switches (src/lib/signup-client.ts reads these two).
//
// Another language: lang ("fa") sets the direction (right to left for fa,
// ar, he) and og:locale; the components use logical properties, so they
// mirror by themselves. A site with its own typeface sets --font-site in its
// stylesheet and passes its file as fontPreload. strictCsp loads the
// first-paint script as a file instead of inline, for a policy without
// 'unsafe-inline'. The "head" slot takes anything else the page needs there.
import geist from "../../fonts/Geist-Variable.woff2?url";
import bootSrc from "../lib/boot.js?url&no-inline";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** The site's origin, for the canonical URL when Astro.site is unset. */
  siteUrl: string;
  /** Article pages set this so the card and the crawlers know what it is. */
  type?: "website" | "article";
  /** ISO date, for articles. */
  published?: string;
  /** schema.org objects for this page. */
  structured?: Record<string, unknown>[];
  /** GET <app>/api/signup and the app's sign-up page. */
  signupApi?: string;
  signupUrl?: string;
  /** Where the plans are, for "Choose a plan" when only paid sign-up is open. */
  pricingUrl?: string;
  /** Extra <link rel="alternate"> feeds. */
  feeds?: { title: string; href: string }[];
  /** The page's language ("en", "fa"). */
  lang?: string;
  /** Text direction; follows lang unless given. */
  dir?: "ltr" | "rtl";
  /** og:site_name. */
  siteName?: string;
  /** og:locale ("fa_IR"). */
  ogLocale?: string;
  /** A share image (absolute, or a path on the site), 1200×630: a large card. */
  image?: string;
  imageAlt?: string;
  /** The canonical URL, when the path Astro sees is not the public one. */
  canonical?: string;
  /** Keep the page out of search engines (no canonical then). */
  noindex?: boolean;
  /** The font file to preload; false for none. Default Geist. */
  fontPreload?: string | false;
  /** Load the first-paint script as a file, for a CSP without 'unsafe-inline'. */
  strictCsp?: boolean;
}

const { title, description, siteUrl, type = "website", published, structured = [], signupApi, signupUrl, pricingUrl = "/pricing/", feeds = [], lang = "en", siteName = "foldrun", ogLocale, image, imageAlt, noindex = false, fontPreload = geist, strictCsp = false } = Astro.props;
const dir = Astro.props.dir ?? (/^(fa|ar|he|ur)\b/.test(lang) ? "rtl" : "ltr");
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site ?? siteUrl).toString();
const imageUrl = image ? new URL(image, Astro.site ?? siteUrl).toString() : undefined;
const ld = (o: unknown) => JSON.stringify(o).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang} dir={dir === "rtl" ? "rtl" : undefined} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {strictCsp ? <script is:inline src={bootSrc}></script> : <script is:inline>
      document.documentElement.classList.add("js");
      try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t); } catch (e) {}
    </script>}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {ogLocale && <meta property="og:locale" content={ogLocale} />}
    {published && <meta property="article:published_time" content={published} />}
    <!-- `summary` unless the page names an image: a large-image card with no
         image renders blank on X/Slack/LinkedIn. -->
    {imageUrl ? (
      <Fragment>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        <meta name="twitter:card" content="summary_large_image" />
      </Fragment>
    ) : <meta name="twitter:card" content="summary" />}
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    {signupApi && <meta name="foldrun-signup-api" content={signupApi} />}
    {signupUrl && <meta name="foldrun-signup-url" content={signupUrl} />}
    {signupApi && <meta name="foldrun-pricing-url" content={pricingUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {feeds.map((f) => <link rel="alternate" type="application/rss+xml" title={f.title} href={f.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {fontPreload && <link rel="preload" href={fontPreload} as="font" type="font/woff2" crossorigin />}
    {/* foldrun-allow-html: JSON-LD is JSON.stringify output with every "<" escaped (ld above), so no value can close the script */}
    {structured.map((s) => <script is:inline type="application/ld+json" set:html={ld(s)} />)}
    <slot name="head" />
  </head>
  <body class="flex min-h-full flex-col bg-paper text-fg antialiased">
    <slot name="header" />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
