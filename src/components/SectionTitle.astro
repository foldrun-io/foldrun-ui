---
// A section's heading and one line under it.
interface Props { title?: string; intro?: string; eyebrow?: string; center?: boolean; class?: string; id?: string }
const { title, intro, eyebrow, center = false, class: cls = "", id } = Astro.props;
---
<div class:list={["mb-10 max-w-3xl space-y-4 sm:mb-14", center && "mx-auto text-center", cls]}>
  {eyebrow && <p class="text-sm font-medium text-fg-muted">{eyebrow}</p>}
  {title && <h2 id={id} class="t-display t-h2">{title}</h2>}
  {intro && <p class:list={["t-lead max-w-2xl", center && "mx-auto"]}>{intro}</p>}
  <slot />
</div>
