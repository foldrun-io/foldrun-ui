---
// A card: a tile (an icon or a vendor's monogram), a title, a line under
// it, an optional meta line, and anything else in the slot. With href the
// whole card is a link with an arrow. dashed is the "add your own" card.
// Every card on the site is this component.
import Icon from "./Icon.astro";
import IconTile from "./IconTile.astro";
import Monogram from "./Monogram.astro";
interface Props {
  title: string;
  body?: string;
  href?: string;
  icon?: string;
  mark?: string;      // a vendor's name: drawn as a monogram tile
  meta?: string;      // a small line above the title (a date) or under it (a key)
  metaAbove?: boolean;
  dashed?: boolean;
  level?: "h2" | "h3" | "h4";
  size?: "md" | "lg";
  class?: string;
}
const { title, body, href, icon, mark, meta, metaAbove = false, dashed = false, level = "h3", size = "md", class: cls = "" } = Astro.props;
const H = level;
const Tag = href ? "a" : "div";
const ext = href ? /^(https?:|mailto:)/.test(href) : false;
---
<Tag
  href={href}
  class:list={[
    "group flex h-full min-w-0 flex-col rounded-xl border transition-colors",
    size === "lg" ? "gap-6 p-6 sm:p-8" : mark ? "gap-3 p-4" : "gap-6 p-6",
    dashed ? "border-dashed" : "bg-surface",
    href && "hover:border-line-strong",
    cls,
  ]}
>
  {icon && !mark && (
    <div class="flex items-start justify-between gap-3">
      <IconTile name={icon} raised={!dashed} />
      {href && <Icon name="arrow-up-right" class:list={["size-4 shrink-0 text-fg-muted transition-transform group-hover:text-fg", !ext && "group-hover:translate-x-0.5"]} />}
    </div>
  )}
  {mark ? (
    <div class="flex items-center gap-3">
      <Monogram name={mark} />
      <div class="min-w-0">
        <H class="truncate text-sm font-medium">{title}</H>
        {meta && <code class="font-mono text-xs text-fg-muted">{meta}</code>}
      </div>
    </div>
  ) : (
    <div class="space-y-2">
      {meta && metaAbove && <p class="text-sm text-fg-muted">{meta}</p>}
      <H class:list={["flex items-start justify-between gap-3 font-semibold tracking-[-0.02em]", size === "lg" ? "text-xl" : "text-lg"]}>
        <span class:list={[href && "group-hover:underline group-hover:underline-offset-4 group-hover:decoration-line-strong"]}>{title}</span>
        {href && !icon && <Icon name="arrow-up-right" class:list={["mt-1 size-4 shrink-0 text-fg-muted transition-transform group-hover:text-fg", !ext && "group-hover:translate-x-0.5"]} />}
      </H>
      {body && <p class="text-sm leading-6 text-pretty text-fg-muted">{body}</p>}
      {meta && !metaAbove && <p class="font-mono text-xs text-fg-muted">{meta}</p>}
    </div>
  )}
  {mark && body && <p class="text-sm leading-6 text-fg-muted">{body}</p>}
  <slot />
</Tag>
